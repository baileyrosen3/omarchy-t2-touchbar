#!/bin/bash
set -euo pipefail

theme_dir="@HOME@/.local/state/omarchy/current/theme"
palette="$theme_dir/colors.toml"
output_dir="@HOME@/.config/omarchy/touchbar/build"
lucide_dir="@HOME@/.config/omarchy/touchbar/lucide"
simple_dir="@HOME@/.config/omarchy/touchbar/simple-icons"

read_color() {
  local key="$1"
  local fallback="$2"
  local value

  value=$(awk -F= -v wanted="$key" '
    $1 ~ "^[[:space:]]*" wanted "[[:space:]]*$" {
      value=$2
      gsub(/[[:space:]\"\047]/, "", value)
      print value
      exit
    }
  ' "$palette" 2>/dev/null || true)
  printf '%s' "${value:-$fallback}"
}

foreground=$(read_color foreground '#f5f5f5')
background=$(read_color background '#111111')
accent=$(read_color accent '#7aa2f7')
theme_mode=$(read_color mode dark)
brand_zen='#F0DE8A'
brand_herdr='#7C3AED'
brand_riptide='#00AEEF'
brand_youtube='#FF0000'
brand_claude='#D97757'
brand_codex='#FFFFFF'
brand_gemini='#8E75B2'
brand_gmail='#EA4335'
brand_files='#3584E4'
voice_blue='#4F8CFF'
voice_purple='#A855F7'
if [[ "$theme_mode" == "dark" ]]; then
  brand_x='#FFFFFF'
else
  brand_x='#000000'
fi
font_name=$(omarchy font current 2>/dev/null || true)
font_name=${font_name:-Liberation Mono}

mkdir -p "$output_dir"

write_lucide() {
  local source="$1"
  local name="$2"
  local color="$3"
  sed \
    -e "s/currentColor/$color/g" \
    -e 's/stroke-width="2"/stroke-width="2.35"/' \
    "$lucide_dir/$source.svg" > "$output_dir/$name.svg"
}

write_voice() {
  local name="$1"
  local glow="$2"
  local filter=''
  if [[ "$glow" == true ]]; then
    filter=' filter="url(#voiceGlow)"'
  fi
  sed \
    -e 's/currentColor/url(#voiceGradient)/g' \
    -e 's/stroke-width="2"/stroke-width="2.35"/' \
    -e "s|<path |<path$filter |" \
    -e "s|</svg>|<defs><linearGradient id=\"voiceGradient\" x1=\"2\" y1=\"4\" x2=\"22\" y2=\"20\" gradientUnits=\"userSpaceOnUse\"><stop stop-color=\"$voice_blue\"/><stop offset=\"1\" stop-color=\"$voice_purple\"/></linearGradient><filter id=\"voiceGlow\" x=\"-70%\" y=\"-70%\" width=\"240%\" height=\"240%\"><feGaussianBlur stdDeviation=\"1.6\" result=\"blur\"/><feFlood flood-color=\"$voice_purple\" flood-opacity=\"0.95\" result=\"color\"/><feComposite in=\"color\" in2=\"blur\" operator=\"in\" result=\"glow\"/><feMerge><feMergeNode in=\"glow\"/><feMergeNode in=\"SourceGraphic\"/></feMerge></filter></defs></svg>|" \
    "$lucide_dir/audio-waveform.svg" > "$output_dir/$name.svg"
}

write_simple() {
  local source="$1"
  local name="$2"
  local color="$3"
  sed "s|<svg |<svg fill=\"$color\" |" \
    "$simple_dir/$source.svg" > "$output_dir/$name.svg"
}

write_keyboard() {
  local source=keyboard
  local name="$1"
  local mark="$2"
  sed \
    -e "s/currentColor/$foreground/g" \
    -e 's/stroke-width="2"/stroke-width="2.35"/' \
    -e "s|</svg>|<circle cx=\"19\" cy=\"19\" r=\"4\" fill=\"$background\"/><path d=\"M17 19h4$mark\" stroke=\"$accent\" stroke-width=\"2.35\" stroke-linecap=\"round\"/></svg>|" \
    "$lucide_dir/$source.svg" > "$output_dir/$name.svg"
}

write_lucide menu menu "$foreground"
write_lucide layout-grid apps-menu "$foreground"
write_lucide square-terminal terminal "$foreground"
write_voice dictate-idle false
write_voice dictate-active true
write_lucide scan-line screenshot "$foreground"
write_lucide sun-dim brightness-low "$foreground"
write_lucide sun brightness-high "$foreground"
write_keyboard keyboard-low ''
write_keyboard keyboard-high 'm-2 0 2-2m-2 2 2 2'
write_lucide skip-back fast_rewind "$foreground"
write_lucide play media-play-disabled "$accent"
write_lucide play media-play "$foreground"
write_lucide pause media-pause "$foreground"
write_lucide skip-forward fast_forward "$foreground"
write_lucide volume-1 volume_down "$foreground"
write_lucide volume-x volume_off "$foreground"
write_lucide volume-2 volume_up "$foreground"

# App launcher layer
write_lucide arrow-left app-back "$foreground"
write_simple zenbrowser app-zen "$brand_zen"
write_lucide bot app-herdr "$brand_herdr"
write_lucide waves-horizontal app-riptide "$brand_riptide"
write_simple youtubemusic app-youtube-music "$brand_youtube"
write_simple youtube app-youtube "$brand_youtube"
write_simple x app-x "$brand_x"
write_simple claude app-claude "$brand_claude"
write_simple openai app-codex "$brand_codex"
write_simple googlegemini app-gemini "$brand_gemini"
write_simple gmail app-gmail "$brand_gmail"
write_lucide folder app-files "$brand_files"

sed \
  -e "s|@FONT@|$font_name|g" \
  -e "s|@BACKGROUND@|$background|g" \
  -e "s|@FOREGROUND@|$foreground|g" \
  @HOME@/.config/omarchy/touchbar/config.template.toml \
  > "$output_dir/config.toml"

touch "$output_dir/.ready"
